{
  "name": "ip-ban-list-cli",
  "version": "0.1.0",
  "description": "CLI to manage and seed an ip-ban-list",
  "main": "bin.js",
  "files": [
    "bin.js",
    "bare-bin.js"
  ],
  "bin": {
    "ip-ban-list": "bin.js",
    "ip-ban-list-bare": "bare-bin.js"
  },
  "scripts": {
    "format": "prettier --write .",
    "test": "lunte && prettier --check . && lunte && brittle test/*.js",
    "test:bare": "brittle-bare test/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/ip-ban-list-cli.git"
  },
  "keywords": [
    "ip",
    "ban",
    "list",
    "cli",
    "hyperswarm"
  ],
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/ip-ban-list-cli/issues"
  },
  "homepage": "https://github.com/holepunchto/ip-ban-list-cli#readme",
  "dependencies": {
    "bare-os": "^3.6.2",
    "bare-path": "^3.0.0",
    "bare-process": "^4.2.2",
    "corestore": "^7.7.0",
    "graceful-goodbye": "^1.3.3",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.16.0",
    "ip-ban-list": "^0.3.0",
    "paparam": "^1.10.0"
  },
  "devDependencies": {
    "bare-events": "^2.8.2",
    "bare-subprocess": "^6.0.0",
    "brittle": "^3.7.0",
    "hyperdht": "^6.27.0",
    "lunte": "^1.7.0",
    "newline-decoder": "^1.0.2",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "which-runtime": "^1.3.2"
  },
  "imports": {
    "child_process": {
      "bare": "bare-subprocess",
      "default": "child_process"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  }
}
